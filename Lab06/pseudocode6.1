add_child 

FUNCTION add_child(child)
    ADD child to this node's children list
    SET child's parent to this node
END FUNCTION




remove_child

FUNCTION remove_child(child)
    IF child is in this node's children list
        REMOVE child from children list
        SET child's parent to None
    END IF
END FUNCTION




is_leaf

FUNCTION is_leaf
    IF children list is empty
        RETURN TRUE
    ELSE 
        RETURN FALSE
    END IF
END FUNCTION




depth

FUNCTION depth  
    SET depth_count to 0
    SET current_node to this node

    WHILE current_node has a parent
        INCREASE depth_count by 1
        SET current_node to current_node's parent
    END WHILE

    RETURN depth_count
END FUNCTION




find

FUNCTION find(name)
    IF this node's name equals name
        RETURN this node
    END IF

    FOR each child in children
        SET result to child.find(name)

        IF result is not None
            RETURN result
        END IF
    END FOR

    RETURN None
END FUNCTION




print_tree

FUNCTION print_tree(indent)
    PRINT indentation followed by this node's name

    FOR each child in children
        CALL child.print_tree(indent + 1)
    END FOR 
END FUNCTION